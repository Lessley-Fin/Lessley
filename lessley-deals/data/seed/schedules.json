[
  { "_comment": "Biweekly cadence — every source runs on the 1st and 15th at its own slot. Day-of-month cron rather than a 14d interval on purpose: interval schedules are anchored on process start (the scheduler recomputes now + interval each loop and persists nothing), so a worker restarting more often than 14 days would never fire. Cron is wall-clock anchored and survives restarts. Times stay staggered so ten sources don't hit the network at once." },
  {
    "source_id": "hot",
    "cron": "0 2 1,15 * *",
    "timeout_seconds": 3600,
    "jitter_seconds": 120,
    "retry": { "max_attempts": 3, "base_delay_seconds": 30, "max_delay_seconds": 600 }
  },
  {
