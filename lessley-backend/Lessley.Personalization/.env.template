# .env
ENVIRONMENT="Development"

# ===========================
# RabbitMQ Configuration
# ===========================
ConnectionStrings_Rabbit="amqp://YOUR_USERNAME:YOUR_PASSWORD@localhost/"
RabbitMQ_Enabled=True

# ===========================
# Open Finance Configuration
# ===========================
OpenFinanceConfig_ClientId=your_open_finance_client_id_here
OpenFinanceConfig_ClientSecret=your_open_finance_client_secret_here
OpenFinanceConfig_BaseUrl="https://api.open-finance.ai"
Cors_AllowOrigins="http://localhost:8000,http://127.0.0.1:8000"

# ===========================
# Grafana Configuration
# ===========================
Loki_Url="http://localhost:3100/loki/api/v1/push"

# ===========================
# MongoDB Configuration
# ===========================s
ConnectionStrings_MongoDb="mongodb://YOUR_USERNAME:YOUR_PASSWORD@localhost:27017/"

# Shared secret the edge (Caddy) stamps as X-Edge-Key. Server-only, never sent to a
# browser. Leave blank in Mode 1, where nothing sits in front of this service.
Edge_ApiKey=

# ── Mode 1 only (no Caddy in front) ───────────────────────────────────────────
# Caddy normally authenticates the caller and injects X-Auth-Email; without it every
# user-scoped route returns 401. Both of these are required, and Environment must also
# be Development — one flag alone cannot open a deployed environment.
Edge_AllowUnverified=True
Dev_AuthEmail=you@example.com
