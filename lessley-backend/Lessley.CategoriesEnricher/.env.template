# .env
ENVIRONMENT="Development"

# ===========================
# RabbitMQ Configuration
# ===========================
ConnectionStrings_Rabbit="amqp://YOUR_USERNAME:YOUR_PASSWORD@localhost/"
RabbitMQ_Enabled=False

# ===========================
# Open Finance Configuration
# ===========================
OpenFinanceConfig_ClientId=your_open_finance_client_id_here
OpenFinanceConfig_ClientSecret=your_open_finance_client_secret_here
OpenFinanceConfig_BaseUrl="https://api.open-finance.ai"

# ===========================
# OpenAI Configuration
# ===========================
OpenAI_ApiKey=your_openai_api_key_here

# ===========================
# Grafana Configuration
# ===========================
Loki_Url="http://localhost:3100/loki/api/v1/push"

# ===========================
# Personalization Configuration
# ===========================
Personalization_Service_Url="http://localhost:5002"
