# Local development: leave the gateway URL EMPTY so API/SignalR calls are relative and
# routed through the Vite dev-server proxy (same-origin — mirrors the Caddy prod setup,
# so cookies/CSRF behave identically and there is no CORS to configure).
#
# Ports: client 8000 (dev) / 5000 (prod preview) · gateway 8001 (dev) / 5001 (prod).
# The client talks ONLY to the gateway — it never addresses Personalization.
VITE_API_GATEWAY_URL=

# Where the gateway runs, for the dev proxy to forward to:
#   http://localhost:8001  -> gateway via `dotnet run` (http profile) or Docker
VITE_GATEWAY_PROXY_TARGET=http://localhost:8001

# Production is built with VITE_API_GATEWAY_URL empty too (see .env.production): the SPA
# is served same-origin by Caddy, which proxies /api and /hubs to the gateway.
