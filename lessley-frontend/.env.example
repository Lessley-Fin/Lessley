# Copy to .env for local development (Mode 1). None of these are VITE_-prefixed, so none
# reach the browser bundle — vite.config.ts reads them in Node to configure the dev proxy.
# The SPA itself needs no config: every API call is relative, because it is always served
# same-origin (by Caddy in prod, by this proxy in dev).

# Where the dev proxy forwards. 8001/8002 via `dotnet run` + `uvicorn`, or via Docker.
GATEWAY_PROXY_TARGET=http://localhost:8001
PERSONALIZATION_PROXY_TARGET=http://localhost:8002

# Mode 1 has no Caddy, so nothing authenticates the caller or injects their identity; the
# dev proxy sends this as X-Auth-Email instead. Must match a user in Mongo. Personalization
# also needs Environment=Development + Edge_AllowUnverified=True.
DEV_AUTH_EMAIL=
