# ===========================
# MongoDB Configuration
# ===========================
DB_NAME=lessley
DB_USER=guest
DB_PASS=your_secure_mongodb_password_here                               # update here
DB_FILE_LIMIT_SIZE=20MB                                                 # update here

# ===========================
# RabbitMQ Configuration
# ===========================
RABBIT_USER=guest
RABBIT_PASS=your_secure_rabbitmq_password_here                          # update here

# ===========================
# JWT Configuration
# ===========================
JWT_KEY=your_jwt_secret_key_min_32_characters_long                      # update here
JWT_ISSUER=lessley-app
JWT_AUDIENCE=lessley-users

# ===========================
# Open Finance Configuration
# ===========================
OpenFinanceConfig_ClientId=lessley-openfinance-client-id                # update here
OpenFinanceConfig_ClientSecret=lessley-openfinance-client-secret        # update here

# ===========================
# Bootstrap Configuration
# ===========================
BOOTSTRAP_USER=bootstrap-user
BOOTSTRAP_EMAIL=lessley.finance@gmail.com
BOOTSTRAP_PASSWORD=initial_admin_password                               # update here
BOOTSTRAP_KEY=bootstrap-secret-key                                      # update here

# ===========================
# Grafana Configuration
# ===========================
GRAFANA_USER=lessley-grafana-user                                        # update here
GRAFANA_PASS=lessley-grafana-password                                    # update here
LOKI_URL="http://loki:3100"                                              # update here

# ===========================
# Caddy edge (both dev and prod use the same Caddyfile)
# ===========================
# DEV (docker-compose.yaml): you can leave these UNSET — the dev compose defaults
#   DOMAIN=localhost (Caddy issues an internal-CA cert) and HSTS_MAX_AGE=max-age=0.
#   Open the app at https://localhost (trust the local cert once — see README).
# PROD (docker-compose.prod.yaml): set DOMAIN to your public host; DNS must point here.
DOMAIN=lessley.example.com                                             # prod: single public host: Caddy serves the SPA AND the API here   # update here
ACME_EMAIL=ops@lessley.example.com                                     # prod: Let's Encrypt contact/expiry email            # update here
# HSTS_MAX_AGE — leave unset in prod (strong default). The dev compose sets max-age=0.
# (No FRONTEND_ORIGIN needed — the SPA is served same-origin, so there is no CORS.)

# Shared secret so the gateway (and only the gateway) can call Personalization.
# Generate with: openssl rand -base64 48
GATEWAY_API_KEY=your_gateway_shared_secret_here                        # update here

# Optional: expose the RabbitMQ management UI over TLS via Caddy. Leave RABBIT_DOMAIN
# empty to keep the UI unreachable from the internet (reach it via SSH tunnel instead).
# Generate the hash with: docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-pass'
RABBIT_DOMAIN=                                                          # e.g. rabbit.lessley.example.com (optional)
RABBIT_BASICAUTH_USER=                                                  # optional
RABBIT_BASICAUTH_HASH=                                                  # optional (bcrypt hash from `caddy hash-password`)