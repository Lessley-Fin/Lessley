# ===========================
# Caddy edge (both dev and prod use the same Caddyfile)
# ===========================
# DEV (docker-compose.yaml): you can leave these UNSET — the dev compose defaults
#   DOMAIN=localhost (Caddy issues an internal-CA cert) and HSTS_MAX_AGE=max-age=0.
#   Open the app at https://localhost (trust the local cert once — see README).
# PROD (docker-compose.prod.yaml): set DOMAIN to our college DNS name (see
#   CADDY_TLS_DIRECTIVE below — that's what actually serves TLS for it, not this DOMAIN
#   value on its own).
DOMAIN=lessley.example.com                                         # prod: Caddy serves the SPA AND the API here        # update here
ACME_EMAIL=ops@lessley.example.com                                     # required by Caddy's global config; never actually used (no ACME here — see CADDY_TLS_DIRECTIVE)
# HSTS_MAX_AGE — leave unset in prod (strong default). The dev compose sets max-age=0.
# (No FRONTEND_ORIGIN needed — the SPA is served same-origin, so there is no CORS.)

# Shared secret so only the edge can call the services behind it.
# Generate with: openssl rand -base64 48
EDGE_API_KEY=your_edge_shared_secret_here                              # update here
# Server-only. Caddy stamps it as X-Edge-Key; Gateway, Personalization and
# deal-optimizer all reject anything without it. Never expose this to a browser.
# One key covers all three — adding the optimizer needs no new secret.

# Admin UIs (RabbitMQ mgmt / Grafana / mongo-express): no extra vars needed — they're
# reached at https://<DOMAIN>:8543 / :8544 / :8545, reusing DOMAIN + CADDY_TLS_DIRECTIVE
# above (see the bottom of Caddyfile). Just publish the port(s) you want on the caddy
# service in docker-compose.prod.yaml.

RABBIT_DOMAIN=                                                          # e.g. rabbit.lessley.example.com (optional)
RABBIT_BASICAUTH_USER=                                                  # optional
RABBIT_BASICAUTH_HASH=                                                  # optional (bcrypt hash from `caddy hash-password`)
GRAFANA_DOMAIN=                                                         # e.g. grafana.lessley.example.com (optional)
MONGOEXPRESS_DOMAIN=                                                    # e.g. mongo.lessley.example.com (optional)
MONGOEXPRESS_BASICAUTH_USER=                                            # optional
MONGOEXPRESS_BASICAUTH_HASH=

# Our pre-issued cert for DOMAIN (from the college network's own PKI) — required in prod.
# Drop the cert+key in lessley-cd/certs/ (gitignored — never commit the private key),
# then set this to the FULL Caddy `tls` directive, pointing at the in-container paths.
# See CUSTOM-CA-CERT.md.
CADDY_TLS_DIRECTIVE=tls /etc/caddy/certs/root.crt /etc/caddy/certs/root.key

# ===========================
# LLM (deals-worker constraints enrichment)
# ===========================
# The deals-worker parses each scraped deal's terms into a structured
# `constraints` block (DEALS_ENRICH_CONSTRAINTS=1 in docker-compose.yaml).
# These select and configure the model that answers those calls.
#
# college (default) — the faculty's self-hosted gpt-oss-120b, spoken to over
#   the OpenAI-compatible API. COLLEGE_API_BASE is an internal IP with a
#   self-signed cert, so the host running this stack must be on the college
#   network. COLLEGE_MODEL_HOST is the Host header Run:AI's ingress routes on.
# azure   — fall back to OPENAI_API_KEY (models.inference.ai.azure.com).
#
# Leave these empty and constraints parsing is logged and skipped on every
# deal; scraping itself is unaffected.
LLM_PROVIDER=college
COLLEGE_API_BASE=                                                       # e.g. https://10.10.248.21/v1
COLLEGE_MODEL_HOST=                                                     # e.g. gpt-oss-120b-mxfp4-runai-model-120b.cs.colman.ac.il
COLLEGE_MODEL_NAME=                                                     # e.g. gpt-oss-120b
COLLEGE_API_KEY=                                                        # optional — the endpoint does not require one
OPENAI_API_KEY=                                                         # only for LLM_PROVIDER=azure
