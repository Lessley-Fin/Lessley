# ===========================
# MongoDB Configuration
# ===========================
DB_NAME=lessley
DB_USER=guest
DB_PASS=your_secure_mongodb_password_here                               # update here
DB_FILE_LIMIT_SIZE=20MB                                                 # update here

# ===========================
# RabbitMQ Configuration
# ===========================
RABBIT_USER=guest
RABBIT_PASS=your_secure_rabbitmq_password_here                          # update here

# ===========================
# JWT Configuration
# ===========================
JWT_KEY=your_jwt_secret_key_min_32_characters_long                      # update here
JWT_ISSUER=lessley-app
JWT_AUDIENCE=lessley-users

# ===========================
# Open Finance Configuration
# ===========================
OpenFinanceConfig_ClientId=lessley-openfinance-client-id                # update here
OpenFinanceConfig_ClientSecret=lessley-openfinance-client-secret        # update here

# ===========================
# Bootstrap Configuration
# ===========================
BOOTSTRAP_USER=bootstrap-user
BOOTSTRAP_EMAIL=lessley.finance@gmail.com
BOOTSTRAP_PASSWORD=initial_admin_password                               # update here
BOOTSTRAP_KEY=bootstrap-secret-key                                      # update here

# ===========================
# Grafana Configuration
# ===========================
GRAFANA_USER=lessley-grafana-user                                        # update here 
GRAFANA_PASS=lessley-grafana-password                                    # update here
LOKI_URL="http://loki:3100"                                              # update here

# ===========================
# Deals Pipeline Configuration
# ===========================
DEALS_LOG_LEVEL=INFO
DEALS_AUTO_MATCH_THRESHOLD=0.90
DEALS_REVIEW_THRESHOLD=0.50
# Storage backend: "mongo" uses MongoDB (shared, no git conflicts), "json" uses local files (default)
# MONGO_URI is auto-built from DB_USER/DB_PASS/DB_NAME above — no new secrets needed
DEALS_STORAGE=mongo
MONGO_URI=mongodb://guest:guest@localhost:27017/lessley?authSource=admin

# ===========================
# HOT Scraper Configuration
# ===========================
HOT_PAGE_START=1
HOT_MAX_PAGES=10
HOT_REQUEST_DELAY=0.7

# ===========================
# Behatsdaa Scraper Configuration
# ===========================
BEHATSDAA_ACCESS_TOKEN=
BEHATSDAA_COOKIE=
BEHATSDAA_ORGANIZATION_ID=20
BEHATSDAA_NATIVE=true
BEHATSDAA_ORIGIN=https://www.behatsdaa.org.il
BEHATSDAA_REFERER=https://www.behatsdaa.org.il/