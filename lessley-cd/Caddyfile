# ── Lessley edge: TLS + SPA host + API proxy (single origin) ──────────────────
# ONE Caddyfile drives BOTH dev and prod — same operation, same networking. Caddy is
# the only host-published web edge. It terminates TLS, serves the built React SPA, and routes
# /api/v1 to whichever service owns the prefix over the private Docker network. Because the
# SPA and API share one origin, there is no CORS and SameSite=Strict "just works".
#
# The only things that differ between dev and prod are env values (not this file):
#   * DOMAIN=localhost (dev)  → Caddy issues an internal-CA cert automatically (no ACME).
#     DOMAIN=your.domain (prod) → Caddy gets a Let's Encrypt cert + renews it.
#   * HSTS_MAX_AGE=max-age=0 (dev) disables HSTS so https://localhost cannot pin other
#     localhost http projects; prod leaves it unset → the strong default below applies.
#   * CADDY_TLS_DIRECTIVE (optional, unset by default) — set to a full `tls` directive to
#     make Caddy load a pre-issued certificate/key instead of automatic HTTPS, e.g.
#     `tls /etc/caddy/certs/college.crt /etc/caddy/certs/college.key`. For a private/
#     local-only DNS name (an internal college or corporate network) where neither Let's
#     Encrypt (needs public resolution) nor the internal CA (needs client trust
#     distribution) are options, but you were handed a cert+key already trusted on that
#     network. See lessley-cd/CUSTOM-CA-CERT.md.
#     NOTE: this must be a whole-directive placeholder, not e.g. `tls {$CERT} {$KEY}` with
#     blank defaults — a bare `tls` with empty/no arguments is a Caddyfile PARSE ERROR, not
#     a no-op. Substituting the entire line (this var empty -> empty line -> truly skipped)
#     is the only way to make this optional without breaking every other deployment.
#
# The SPA files are baked into this image at /srv/frontend (see lessley-frontend/Dockerfile).
# Required env vars (.env.template): DOMAIN, ACME_EMAIL.
# Optional: HSTS_MAX_AGE, RABBIT_DOMAIN (+ RABBIT_BASICAUTH_USER / RABBIT_BASICAUTH_HASH),
# CADDY_TLS_DIRECTIVE.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	# Empty (the default) expands to a blank line — skipped entirely, so automatic HTTPS
	# decides ACME vs internal issuance from DOMAIN exactly as before. Set the whole
	# directive to override; see the CADDY_TLS_DIRECTIVE note above.
	{$CADDY_TLS_DIRECTIVE:}
	encode gzip

	# Security headers applied to every response on this site.
	# HSTS is env-driven so dev (localhost) can send max-age=0 while prod keeps the
	# strong default; the directive itself is identical in both environments.
	header {
		Strict-Transport-Security "{$HSTS_MAX_AGE:max-age=31536000; includeSubDomains; preload}"
		X-Content-Type-Options    "nosniff"
		X-Frame-Options           "DENY"
		Referrer-Policy           "no-referrer"
		-Server
	}

	# Nothing outside may assert edge trust or identity. Stripped before any routing so a
	# client cannot forge either header; the values below are set by us, on the way in.
	request_header -X-Edge-Key
	request_header -X-Auth-Email

	# ── Personalization-owned prefixes ──────────────────────────────────────────
	# These MUST precede the general /api/v1/* handler: `handle` blocks match top-down.
	# Personalization has no user-level authorization of its own — it trusts X-Auth-Email
	# — so forward_auth is what makes exposing it safe. Do not add a route here without it.
	@personalization path /api/v1/insights/* /api/v1/open-finance/* /api/v1/clubs/*
	handle @personalization {
		forward_auth gateway:5001 {
			uri /api/auth/verify
			copy_headers X-Auth-Email
			header_up X-Edge-Key {$EDGE_API_KEY}
		}

		uri strip_prefix /api/v1
		reverse_proxy personalization:5002 {
			header_up X-Edge-Key {$EDGE_API_KEY}
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# ── Gateway ─────────────────────────────────────────────────────────────────
	# Rewritten back to /api/* so the Gateway's existing controller routes are unchanged.
	# Not forward_auth'd: the Gateway authenticates its own requests, as it always has.
	handle /api/v1/* {
		uri replace /api/v1/ /api/ 1
		reverse_proxy gateway:5001 {
			header_up X-Edge-Key {$EDGE_API_KEY}
			header_up X-Request-ID {http.request.uuid}
		}
	}

	# SignalR hub — Caddy upgrades the WebSocket automatically.
	handle /hubs/* {
		reverse_proxy gateway:5001 {
			header_up X-Edge-Key {$EDGE_API_KEY}
		}
	}

	# Everything else: the SPA, with history-API fallback so client-side routes reload.
	handle {
		root * /srv/frontend
		header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self'; frame-ancestors 'none'"
		try_files {path} /index.html
		file_server
	}
}

# ── Admin UIs, Option A: separate subdomains (needs a public/self-service DNS zone) ──
# Each block is its own site, on its own subdomain, guarded by HTTP basic auth (Grafana
# has its own login instead, so no extra basic_auth layer there). Only viable if you can
# both create the subdomain's DNS record yourself AND get/automate a certificate for it
# — doesn't work against a single institution-issued cert for one exact hostname (see
# CUSTOM-CA-CERT.md); use Option B below for that case instead.
#
# IMPORTANT — these MUST stay commented unless their *_DOMAIN var is actually set.
# Caddy env substitution in a site ADDRESS has no `:default` fallback (unlike the
# HSTS_MAX_AGE/CADDY_TLS_DIRECTIVE placeholders above, which are inside directive
# values, not addresses): an empty {$RABBIT_DOMAIN} collapses the block to a bare
# `{ ... }`, which Caddy parses as a second *global options* block and refuses to
# start — taking down the whole edge (main site included), not just this route.
# Verified with `caddy validate`. So: uncomment ONLY the block(s) you're enabling,
# and only after setting its env vars — never uncomment one whose *_DOMAIN is unset.
#
# To expose one: set its *_DOMAIN (+ *_BASICAUTH_* where applicable) in .env, point
# that subdomain's DNS A record at this host, generate any password hash with
# `docker run --rm caddy:2-alpine caddy hash-password --plaintext 'your-pass'`,
# then uncomment its block below.

# {$RABBIT_DOMAIN} {
# 	basic_auth {
# 		{$RABBIT_BASICAUTH_USER} {$RABBIT_BASICAUTH_HASH}
# 	}
# 	reverse_proxy rabbitmq:15672
# }

# {$GRAFANA_DOMAIN} {
# 	reverse_proxy grafana:3000
# }

# {$MONGOEXPRESS_DOMAIN} {
# 	basic_auth {
# 		{$MONGOEXPRESS_BASICAUTH_USER} {$MONGOEXPRESS_BASICAUTH_HASH}
# 	}
# 	reverse_proxy mongo-express:8081
# }

# ── Admin UIs, Option B: same hostname, different ports ────────────────────────────
# For a private/institutional DOMAIN like a college network (e.g. lessley.cs.colman.ac.il)
# where you don't control DNS beyond the one name you were given, and your cert (via
# CADDY_TLS_DIRECTIVE, see CUSTOM-CA-CERT.md) was issued for exactly that hostname, not a
# wildcard. TLS validates by hostname, not port, so reusing {$DOMAIN} on extra ports needs
# no new DNS record and no new certificate — the existing one covers all of these too.
# Each app already requires its own login (RabbitMQ/mongo-express/Grafana all do), so no
# extra basic_auth layer. Safe to leave active always: {$DOMAIN} is a required var (never
# empty) and {$CADDY_TLS_DIRECTIVE:} is the same proven-safe empty-default placeholder used
# on the main site above — unlike Option A, nothing here breaks when unused.
#
# Inert until you publish the matching host port on the caddy service in
# docker-compose.prod.yaml — add "8543:8543" / "8544:8544" / "8545:8545" to its `ports:`
# list for whichever of these you want reachable.

{$DOMAIN}:8543 {
	{$CADDY_TLS_DIRECTIVE:}
	reverse_proxy rabbitmq:15672
}

{$DOMAIN}:8544 {
	{$CADDY_TLS_DIRECTIVE:}
	reverse_proxy grafana:3000
}

{$DOMAIN}:8545 {
	{$CADDY_TLS_DIRECTIVE:}
	reverse_proxy mongo-express:8081
}

# (Alternative without exposing anything at all: SSH to the host and
#  `docker compose exec`, or a temporary `-p 15672:15672` style mapping.)
